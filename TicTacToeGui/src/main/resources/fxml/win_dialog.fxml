<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.media.MediaView?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="642.0" prefWidth="543.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.tictactoegui.WinDialogController">
   <children>
      <Region minHeight="0.0" prefHeight="18.0" prefWidth="493.0" style="-fx-background-color: #2b7cee;" />
      <VBox alignment="CENTER" spacing="0.0">
         <padding>
            <Insets bottom="24.0" left="32.0" right="32.0" top="32.0" />
         </padding>
         <children>
            <StackPane maxHeight="80.0" maxWidth="80.0" minHeight="80.0" minWidth="80.0" style="-fx-background-color: #eff6ff; -fx-background-radius: 999; -fx-border-color: white; -fx-border-width: 4; -fx-border-radius: 999;">
               <children>
                  <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/rank_up.png" />
                     </image>
                  </ImageView>
               </children>
               <VBox.margin>
                  <Insets bottom="20.0" />
               </VBox.margin>
            </StackPane>
            <Label fx:id="titleLabel" style="-fx-font-weight: 800; -fx-text-fill: #0f172a;" text="Victory!">
               <font>
                  <Font name="System Bold" size="30.0" />
               </font>
            </Label>
            <HBox alignment="CENTER" spacing="4.0">
               <children>
                  <Label style="-fx-text-fill: #64748b; -fx-font-weight: 500;" text="You won against" />
                  <Label fx:id="opponentName" style="-fx-text-fill: #334155; -fx-font-weight: 700;" text="AlexGamer99" />
               </children>
               <VBox.margin>
                  <Insets top="4.0" />
               </VBox.margin>
            </HBox>
            <StackPane alignment="BOTTOM_CENTER">
               <children>
                  <MediaView fx:id="mediaView" fitWidth="400" preserveRatio="true" />
                  <Label fx:id="videoText" alignment="CENTER" style="-fx-text-fill: black; -fx-font-weight: bold;" text="🎉 Bravo! You Win!" StackPane.alignment="BOTTOM_CENTER">
                     <padding>
                        <Insets bottom="17.0" />
                     </padding>
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>
               </children>
            </StackPane>
            <HBox alignment="CENTER" prefHeight="70.0" spacing="0.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 16; -fx-border-color: #f1f5f9; -fx-border-radius: 16;">
               <children>
                  <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-weight: 800; -fx-font-size: 10px;" text="TOTAL SCORE" />
                        <Label fx:id="scoreLabel" style="-fx-text-fill: #0f172a; -fx-font-weight: 700; -fx-font-size: 20px;" text="1,250" />
                     </children>
                     <padding>
                        <Insets left="16.0" />
                     </padding>
                  </VBox>
                  <Region maxWidth="1.0" minWidth="1.0" prefWidth="1.0" style="-fx-background-color: #e2e8f0;">
                     <HBox.margin>
                        <Insets bottom="12.0" top="12.0" />
                     </HBox.margin>
                  </Region>
                  <VBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-weight: 800; -fx-font-size: 10px;" text="UPDATE" />
                        <HBox alignment="CENTER_RIGHT" spacing="4.0">
                           <children>
                              <Label style="-fx-text-fill: #10b981; -fx-font-weight: 700; -fx-font-size: 18px;" text="+50" />
                           </children>
                        </HBox>
                     </children>
                     <padding>
                        <Insets right="16.0" />
                     </padding>
                  </VBox>
               </children>
               <VBox.margin>
                  <Insets top="32.0" />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
      <VBox prefHeight="177.0" prefWidth="493.0" spacing="12.0">
         <padding>
            <Insets bottom="24.0" left="24.0" right="24.0" />
         </padding>
         <children>
            <JFXButton onAction="#onPlayAgain" prefHeight="48.0" prefWidth="Infinity" style="-fx-background-color: #2b7cee; -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 12; -fx-font-size: 14px; -fx-cursor: hand;" text="Play Again">
               <graphic>
                  <ImageView fitHeight="18.0" fitWidth="18.0">
                     <image>
                        <Image url="@../images/refresh.png" />
                     </image>
                  </ImageView>
               </graphic>
            </JFXButton>
            <JFXButton onAction="#onBackToMainMenu" prefHeight="48.0" prefWidth="Infinity" style="-fx-background-color: transparent; -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-text-fill: #475569; -fx-font-weight: 800; -fx-font-size: 14px; -fx-cursor: hand;" text="Back to Menu">
               <graphic>
                  <ImageView fitHeight="18.0" fitWidth="18.0" rotate="180.0">
                     <image>
                        <Image url="@../images/exit.png" />
                     </image>
                  </ImageView>
               </graphic>
            </JFXButton>
         </children>
      </VBox>
   </children>
</VBox>
