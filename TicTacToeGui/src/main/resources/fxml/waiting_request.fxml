<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<StackPane prefHeight="478.0" prefWidth="353.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.tictactoegui.Waiting_requestController">
   <children>
      <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="360.0" prefWidth="360.0" spacing="20" style="-fx-background-color: white; -fx-background-radius: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 20, 0, 0, 10);">
         <children>
            <Region maxWidth="-Infinity" minWidth="-Infinity" prefHeight="10.0" style="-fx-background-color: #2b7cee; -fx-background-radius: 24 24 0 0;" />
            <VBox alignment="CENTER" prefWidth="354.0" spacing="12.0" style="-fx-padding: 32;">
               <children>
                  <StackPane maxWidth="-Infinity" prefHeight="80" prefWidth="80.0" style="-fx-background-color: #e8f0fe; -fx-background-radius: 40; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 2);">
                     <children>
                        <Label maxWidth="-Infinity" minWidth="-Infinity" style="-fx-font-size: 36; -fx-text-fill: #2b7cee;" text="⏳" />
                        <Circle fill="#3b82f6" radius="6" stroke="white" strokeWidth="2" StackPane.alignment="BOTTOM_RIGHT" />
                     </children>
                  </StackPane>
                  <Label style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="Waiting..." />
                  <TextFlow maxWidth="260" textAlignment="CENTER">
                     <children>
                        <Text style="-fx-font-size: 13; -fx-fill: #64748b;" text="Waiting for " />
                        <Text fx:id="opponentName" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-fill: #334155;" text="AlexGamer99 " />
                        <Text style="-fx-font-size: 13; -fx-fill: #64748b;" text=" to accept your game invitation." />
                     </children>
                  </TextFlow>
                  <VBox alignment="CENTER" spacing="10" style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 16;">
                     <children>
                        <VBox alignment="CENTER_LEFT" spacing="6">
                           <children>
                              <Label style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #64748b;" text="CONNECTING" />
                              <ProgressBar prefWidth="260" progress="0.5" style="-fx-accent: #2b7cee;" />
                           </children>
                        </VBox>
                        <ProgressIndicator prefHeight="28" prefWidth="28" />
                     </children>
                  </VBox>
               </children>
            </VBox>
            <VBox style="-fx-padding: 0 24 24 24;">
               <children>
                  <Button maxWidth="Infinity" onAction="#cancelInviteAction" prefHeight="44" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-background-radius: 16; -fx-border-radius: 16; -fx-cursor: hand;" text="Cancel Invite" />
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</StackPane>
