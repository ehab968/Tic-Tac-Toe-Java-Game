<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.Shadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.media.MediaView?>

<VBox alignment="CENTER" spacing="12" style="-fx-background-color: white; -fx-background-radius: 20;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.tictactoegui.WinDialogController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <!-- Victory -->
    <Label fx:id="titleLabel" style="-fx-font-size: 28px; -fx-font-weight: bold;" text="Victory!" />

    <Label fx:id="subTitleLabel" style="-fx-text-fill: #6b7280;" text="Player X won the game" />

    <!-- 🎥 Video -->
    <MediaView fx:id="mediaView" fitWidth="280" preserveRatio="true" />

    <!-- Score -->
    <VBox alignment="CENTER" prefWidth="260" spacing="4" style="-fx-background-color: #f3f4f6; -fx-background-radius: 12;">
        <padding>
            <Insets bottom="10" left="10" right="10" top="10" />
        </padding>

        <Label style="-fx-font-size: 10px; -fx-text-fill: gray;" text="Total Score" />

        <Label fx:id="scoreLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="1250" />
    </VBox>

    <!-- Buttons -->
    <VBox alignment="CENTER" prefWidth="260" spacing="10">
        <JFXButton buttonType="RAISED" onAction="#onPlayAgain" prefHeight="40.0" prefWidth="260.0" style="-fx-background-color: #2b6cee; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;">
            <graphic>  
                <HBox alignment="CENTER" spacing="10">
                    <ImageView fitHeight="24" fitWidth="24">
                        <image>
                            <Image url="@../images/persons.png" />
                        </image>
                    </ImageView>
                    <Label style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16;" text="Play Again" />
                </HBox>                
            </graphic>
        </JFXButton> 
        
        <JFXButton buttonType="RAISED" cancelButton="true" onAction="#onBackToMainMenu" prefHeight="40.0" prefWidth="260.0" style="-fx-background-color: white; -fx-text-fill: black; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;">
            <graphic>    
                <HBox alignment="CENTER" spacing="10">
                    <ImageView fitHeight="24" fitWidth="24">
                        <image>
                            <Image url="@../images/persons.png" />
                        </image>
                    </ImageView>
                    <Label style="-fx-text-fill: black; -fx-font-weight: bold; -fx-font-size: 16;" text="Back to Menu" />
                </HBox>               
            </graphic>
         <effect>
            <Shadow />
         </effect>
        </JFXButton> 

    </VBox>
</VBox>
