<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600" prefWidth="400" style="-fx-background-color: #f0f4f8;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fxml.Connection_lost_requestController">

    <StackPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="360" spacing="20" style="-fx-background-color: white;                      -fx-background-radius: 24;                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 20, 0, 0, 10);">

            <!-- Top Bar -->
            <Region maxWidth="-Infinity" minWidth="-Infinity" prefHeight="8" prefWidth="350.0" style="-fx-background-color: #2b7cee;                            -fx-background-radius: 24 24 0 0;" />

            <!-- Content -->
            <VBox alignment="CENTER" spacing="14" style="-fx-padding: 32;">

                <!-- Icon -->
                <StackPane maxWidth="-Infinity" prefHeight="80" prefWidth="80" style="-fx-background-color: #e8f0fe;                                   -fx-background-radius: 40;                                   -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 2);">

                    <Label style="-fx-font-size: 36;                                   -fx-text-fill: #2b7cee;" text="📡" />
                </StackPane>

                <!-- Title -->
                <Label style="-fx-font-size: 26;                               -fx-font-weight: bold;                               -fx-text-fill: #0f172a;" text="Connection Lost" />

                <!-- Message -->
                <Label alignment="CENTER" maxWidth="240.0" prefHeight="58.0" prefWidth="211.0" style="-fx-font-size: 13;                               -fx-text-fill: #64748b;                               -fx-font-weight: 500;" text="Connection to the server has been lost. Please check your internet connection and try again." wrapText="true">
               <padding>
                  <Insets left="10.0" right="10.0" />
               </padding>
               <VBox.margin>
                  <Insets left="20.0" />
               </VBox.margin></Label>
            </VBox>

            <!-- Buttons -->
            <VBox spacing="12" style="-fx-padding: 0 24 24 24;">

                <!-- Reconnect -->
                <Button fx:id="reconnectBtn" graphicTextGap="19" maxWidth="Infinity" onAction="#reconnectBtnAction" prefHeight="44" style="-fx-background-color: #2b7cee;                -fx-text-fill: white;                -fx-font-weight: bold;                -fx-font-size: 14;                -fx-background-radius: 16;                -fx-cursor: hand;">

                    <graphic>
                        <Label style="-fx-font-size: 22;                                       -fx-translate-x: -2;                                       -fx-font-weight: bold;                        -fx-text-fill: white;" text="⟳" />
                    </graphic>

                    <text>Reconnect</text>
                </Button>


                <Button fx:id="backArrowBtn" graphicTextGap="17" maxWidth="Infinity" onAction="#backArrowBtnAction" prefHeight="44" style="-fx-background-color: white;                -fx-border-color: #e2e8f0;                -fx-text-fill: #475569;                -fx-font-weight: bold;                -fx-font-size: 14;                -fx-background-radius: 16;                -fx-border-radius: 16;                -fx-cursor: hand;">

                    <graphic>
                        <Label style="-fx-font-size: 18;                       -fx-font-weight: bold;                       -fx-translate-x: -2;                       -fx-text-fill: #475569;" text="←" />
                    </graphic>

                    <text>Back to Menu</text>
                </Button>



            </VBox>

        </VBox>
    </StackPane>
</AnchorPane>
