<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<AnchorPane prefHeight="600" prefWidth="400" style="-fx-background-color: #f0f4f8;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fxml.Rejected_requestController">

    <StackPane maxHeight="-Infinity" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="340.0" prefWidth="350.0" spacing="20.0" style="-fx-background-color: white;                      -fx-background-radius: 24;                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 20, 0, 0, 10);">

            <!-- Top blue bar -->
            <Region maxWidth="-Infinity" prefHeight="9.0" prefWidth="340.0" style="-fx-background-color: #2b7cee;                            -fx-background-radius: 24 24 0 0;">
            <VBox.margin>
               <Insets />
            </VBox.margin></Region>

            <!-- Content -->
            <VBox alignment="CENTER" spacing="12" style="-fx-padding: 32;">

                <!-- Icon circle -->
                <StackPane maxWidth="-Infinity" prefHeight="80" prefWidth="80" style="-fx-background-color: #e8f0fe;                                   -fx-background-radius: 40;                                   -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 2);">

                    <Label maxWidth="-Infinity" style="-fx-font-size: 36;                                   -fx-text-fill: #2b7cee;" text="⛔" />
                </StackPane>

                <!-- Title -->
                <Label style="-fx-font-size: 22;                               -fx-font-weight: bold;                               -fx-text-fill: #0f172a;" text="Request Rejected" />

                <!-- Message -->
                <TextFlow maxWidth="300" textAlignment="CENTER">
    <Text style="-fx-font-size: 15;                  -fx-font-weight: bold;                  -fx-fill: #334155;" text="AlexGamer99 " />

    <Text style="-fx-font-size: 13;                  -fx-fill: #64748b;" text="has rejected your game request." />
</TextFlow>
            </VBox>

            <!-- Button -->
            <VBox alignment="CENTER" style="-fx-padding: 0 24 24 24;">
                <Button fx:id="okBtnRequest" maxWidth="Infinity" onAction="#okBtnRequestAction" prefHeight="44" style="-fx-background-color: #2b7cee;                                -fx-text-fill: white;                                -fx-font-size: 14;                                -fx-font-weight: bold;                                -fx-background-radius: 16;                                -fx-cursor: hand;" text="OK" />
            </VBox>

        </VBox>
    </StackPane>

</AnchorPane>
