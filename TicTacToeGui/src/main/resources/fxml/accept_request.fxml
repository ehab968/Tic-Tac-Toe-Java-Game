<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.tictactoegui.Accept_requestController">
   <children>
      <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="360" spacing="20" style="-fx-background-color: white;                      -fx-background-radius: 24;                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 20, 0, 0, 10);">
         <children>
            <Region maxWidth="-Infinity" minWidth="-Infinity" prefHeight="8" prefWidth="350.0" style="-fx-background-color: #2b7cee;                            -fx-background-radius: 24 24 0 0;" />
            <VBox alignment="CENTER" spacing="14" style="-fx-padding: 32;">
               <children>
                  <StackPane maxWidth="-Infinity" prefHeight="80" prefWidth="80" style="-fx-background-color: #e8f0fe;                                   -fx-background-radius: 40;                                   -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 2);">
                     <children>
                        <Label style="-fx-font-size: 36;                                   -fx-text-fill: #2b7cee;" text="⚔" />
                     </children>
                  </StackPane>
                  <Label style="-fx-font-size: 26;                               -fx-font-weight: bold;                               -fx-text-fill: #0f172a;" text="Invitation" />
                  <HBox alignment="CENTER" spacing="4.0">
                     <children>
                        <Label fx:id="opponentName" text="OpponentName">
                           <font>
                              <Font name="System Bold Italic" size="14.0" />
                           </font>
                        </Label>
                        <Label style="-fx-font-weight: 500;" text="is inviting to battle you " textFill="#2b7cee">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
               </children>
            </VBox>
            <VBox spacing="12" style="-fx-padding: 0 24 24 24;">
               <children>
                  <Button fx:id="acceptBtn" graphicTextGap="19" maxWidth="Infinity" onAction="#acceptBtnAction" prefHeight="44" style="-fx-background-color: #2b7cee;                -fx-text-fill: white;                -fx-font-weight: bold;                -fx-font-size: 14;                -fx-background-radius: 16;                -fx-cursor: hand;" text="Accept Invitation" />
                  <Button fx:id="backArrowBtn" graphicTextGap="17" maxWidth="Infinity" onAction="#backArrowBtnAction" prefHeight="44" style="-fx-background-color: white;                -fx-border-color: #e2e8f0;                -fx-text-fill: #475569;                -fx-font-weight: bold;                -fx-font-size: 14;                -fx-background-radius: 16;                -fx-border-radius: 16;                -fx-cursor: hand;" text="Reject " />
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</StackPane>
