<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<AnchorPane prefHeight="600"
            prefWidth="400"
            style="-fx-background-color: #f0f4f8;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.tictactoegui.Rejected_requestController">

    <StackPane AnchorPane.topAnchor="0"
               AnchorPane.bottomAnchor="0"
               AnchorPane.leftAnchor="0"
               AnchorPane.rightAnchor="0">

        <VBox alignment="CENTER"
              prefHeight="340.0"
              prefWidth="350.0"
              spacing="20.0"
              style="-fx-background-color: white;
                     -fx-background-radius: 24;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 20, 0, 0, 10);">

            <!-- Top blue bar -->
            <Region prefHeight="9.0"
                    prefWidth="340.0"
                    style="-fx-background-color: #2b7cee;
                           -fx-background-radius: 24 24 0 0;">
                <VBox.margin>
                    <Insets/>
                </VBox.margin>
            </Region>

            <!-- Content -->
            <VBox alignment="CENTER" spacing="12" style="-fx-padding: 32;">

                <!-- Icon -->
                <StackPane prefHeight="80"
                           prefWidth="80"
                           style="-fx-background-color: #e8f0fe;
                                  -fx-background-radius: 40;
                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 2);">

                    <Label text="⛔"
                           style="-fx-font-size: 36;
                                  -fx-text-fill: #2b7cee;"/>
                </StackPane>

                <!-- Title -->
                <Label text="Request Rejected"
                       style="-fx-font-size: 22;
                              -fx-font-weight: bold;
                              -fx-text-fill: #0f172a;"/>

                <!-- Message -->
                <TextFlow maxWidth="300" textAlignment="CENTER">
                    <Text text="AlexGamer99 "
                          style="-fx-font-size: 15;
                                 -fx-font-weight: bold;
                                 -fx-fill: #334155;"/>
                    <Text text="has rejected your game request."
                          style="-fx-font-size: 13;
                                 -fx-fill: #64748b;"/>
                </TextFlow>

            </VBox>

            <!-- Button -->
            <VBox alignment="CENTER" style="-fx-padding: 0 24 24 24;">
                <Button fx:id="okBtnRequest"
                        text="OK"
                        prefHeight="44"
                        maxWidth="Infinity"
                        onAction="#okBtnRequestAction"
                        style="-fx-background-color: #2b7cee;
                               -fx-text-fill: white;
                               -fx-font-size: 14;
                               -fx-font-weight: bold;
                               -fx-background-radius: 16;
                               -fx-cursor: hand;"/>
            </VBox>

        </VBox>
    </StackPane>

</AnchorPane>
