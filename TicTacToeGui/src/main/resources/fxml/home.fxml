<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="599.0" prefWidth="1050.0" spacing="20" style="-fx-background-color: linear-gradient(from 50% 0% to 50% 100%, #2b6cee1a, transparent); -fx-padding: 20;" stylesheets="@../styles/styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.tictactoegui.HomeController">
    <StackPane prefHeight="150.0" prefWidth="200.0">
        <children>
      
            <!-- Header -->
            <VBox alignment="CENTER" maxWidth="1030.0" prefHeight="258.0" prefWidth="1030.0" spacing="10" style="-fx-background-color: linear-gradient(to bottom right, #2b6cee1a, transparent); -fx-padding: 20; -fx-border-color: #e5e7eb; -fx-border-width: 0 0 0 0;">
            <HBox>
               <children>
                     <JFXButton alignment="CENTER" buttonType="RAISED" contentDisplay="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" onAction="#onPlayRecord" prefHeight="52.0" prefWidth="110.0" text="Play Record ▶" textAlignment="CENTER" />
               </children>
            </HBox>
                <ImageView fx:id="userAvater2" fitHeight="94.0" fitWidth="267.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/logo.png" />
                    </image>
                </ImageView>
              
                <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Tic Tac Toe" />
      
                <!-- Online Label with Green Indicator -->
                <HBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" spacing="5" style="-fx-background-color: #2b6cee; -fx-padding: 5 10; -fx-border-radius: 20; -fx-background-radius: 20;"> 
                    
                    <Circle fx:id="statusCircle" radius="4" />
    
                    <Label fx:id="statusLabel" style="-fx-font-size: 12; -fx-text-fill: white; -fx-font-weight: bold;" />
                </HBox>
      
            </VBox>
        </children>
    </StackPane>

    <!-- User Greeting -->
    <VBox alignment="CENTER" prefHeight="110.0" prefWidth="1010.0" spacing="2">
        <Label alignment="CENTER" prefHeight="11.0" prefWidth="335.0" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #1f2937;" text="Welcome back, PlayerOne" textAlignment="CENTER">
            <font>
                <Font size="16.0" />
            </font>
        </Label>
        <Label style="-fx-font-size: 14; -fx-text-fill: #6b7280;" text="Ready for your next challenge?">
            <font>
                <Font size="16.0" />
            </font>
        </Label>
    </VBox>

    <!-- Buttons -->
    <VBox alignment="CENTER" spacing="10">

        <JFXButton fx:id="singlePlayerBTN" onAction="#onSelectSinglePlayer" prefHeight="50.0" prefWidth="400.0">
            <graphic>
                <HBox alignment="CENTER" spacing="10">
                    <ImageView fitHeight="24" fitWidth="24">
                        <image>
                            <Image url="@../images/person.png" />
                        </image>
                    </ImageView>
                    <Label style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16;" text="Single Player" />
                </HBox>
            </graphic>
        </JFXButton>

        <JFXButton fx:id="multiplayerBTN" onAction="#onSelectMultiplayer" prefHeight="50.0" prefWidth="400.0">
            <graphic>
                <HBox alignment="CENTER" spacing="10">
                    <ImageView fitHeight="24" fitWidth="24">
                        <image>
                            <Image url="@../images/persons.png" />
                        </image>
                    </ImageView>
                    <Label style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16;" text="Local Multiplayer" />
                </HBox>
            </graphic>
        </JFXButton>

        <JFXButton fx:id="onlineBTN" onAction="#onSelectOnline" prefHeight="50.0" prefWidth="400.0">
            <graphic>
                <HBox alignment="CENTER" spacing="10">
                    <ImageView fitHeight="24" fitWidth="24">
                        <image>
                            <Image url="@../images/online.png" />
                        </image>
                    </ImageView>
                    <Label style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16;" text="Online Multiplayer" />
                </HBox>
            </graphic>
        </JFXButton>

    </VBox>

    <!-- Footer -->
    <Label alignment="BOTTOM_CENTER" style="-fx-font-size: 10; -fx-text-fill: #9ca3af;" text="Tic Tac Toe Client v0.2.0" />

</VBox>
