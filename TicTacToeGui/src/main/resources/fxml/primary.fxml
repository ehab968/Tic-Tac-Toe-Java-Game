<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane fx:id="gamePane" prefHeight="400.0" style="-fx-background-color:#eaf1fd;" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.tictactoegui.PrimaryController">

    <!-- ================= TOP ================= -->
    <top>
        <VBox alignment="CENTER" spacing="10"
              style="-fx-background-color:white;
                     -fx-padding:18;
                     -fx-background-radius:18;
                     -fx-effect:dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);">

            <FlowPane alignment="CENTER" hgap="30">

                <VBox alignment="CENTER" spacing="4">
                    <Text fx:id="userNameText" text="Player X"
                          style="-fx-font-weight:800;
                                 -fx-font-size:18;"/>

                    <Text fx:id="userScoreText" text="Score: 0"
                          style="-fx-font-size:14;
                                 -fx-fill:#475569;"/>

                    <Text fx:id="userStatusText" text="Your Turn"
                          style="-fx-background-color:#95caff;
                                 -fx-fill:#008000;
                                 -fx-padding:4 14;
                                 -fx-background-radius:999;
                                 -fx-font-size:12;
                                 -fx-font-weight:bold;"/>
                </VBox>

                <Text text="VS"
                      style="-fx-font-size:26;
                             -fx-font-weight:bold;
                             -fx-fill:#2b7cee;"/>

                <VBox alignment="CENTER" spacing="4">
                    <Text fx:id="opponentNameText" text="Player O"
                          style="-fx-font-weight:800;
                                 -fx-font-size:18;"/>

                    <Text fx:id="opponentScoreText" text="Score: 0"
                          style="-fx-font-size:14;
                                 -fx-fill:#475569;"/>

                    <Text fx:id="opponentStatusText" text="Waiting"
                          style="-fx-background-color:#e5e7eb;
                                 -fx-fill:#ef4444;
                                 -fx-padding:4 14;
                                 -fx-background-radius:999;
                                 -fx-font-size:12;
                                 -fx-font-weight:bold;"/>
                </VBox>

            </FlowPane>
        </VBox>
    </top>


    <!-- ================= CENTER ================= -->
    <center>
        <GridPane fx:id="gridPane" maxHeight="1.7976931348623157E308" maxWidth="-Infinity" prefHeight="240.0" prefWidth="550.0" style="-fx-background-color: #2b7cee;-fx-border-color: #eaeaea        -fx-border-width: 2px;        -fx-border-radius: 20px;        -fx-background-radius: 20px;" BorderPane.alignment="CENTER">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Button mnemonicParsing="false" prefHeight="114.0" prefWidth="184.0" style="-fx-background-color: #ffffff;">
                    <GridPane.margin>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                    </GridPane.margin>
                </Button>
                <Button mnemonicParsing="false" prefHeight="114.0" prefWidth="191.0" style="-fx-background-color: #ffffff;" GridPane.columnIndex="1">
                    <GridPane.margin>
                        <Insets bottom="10.0" left="10.0" right="20.0" top="10.0" />
                    </GridPane.margin>
                </Button>
                <Button mnemonicParsing="false" prefHeight="113.0" prefWidth="191.0" style="-fx-background-color: #ffffff;" GridPane.columnIndex="2">
                    <GridPane.margin>
                        <Insets bottom="10.0" left="10.0" right="20.0" top="10.0" />
                    </GridPane.margin>
                </Button>
                <Button mnemonicParsing="false" prefHeight="114.0" prefWidth="184.0" style="-fx-background-color: #ffffff;" GridPane.rowIndex="1">
                    <GridPane.margin>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                    </GridPane.margin>
                </Button>
                <Button mnemonicParsing="false" prefHeight="114.0" prefWidth="190.0" style="-fx-background-color: #ffffff;" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <GridPane.margin>
                        <Insets bottom="10.0" left="10.0" right="20.0" top="10.0" />
                    </GridPane.margin>
                </Button>
                <Button mnemonicParsing="false" prefHeight="114.0" prefWidth="192.0" style="-fx-background-color: #ffffff;" GridPane.columnIndex="2" GridPane.rowIndex="1">
                    <GridPane.margin>
                        <Insets bottom="10.0" left="10.0" right="20.0" top="10.0" />
                    </GridPane.margin>
                </Button>
                <Button mnemonicParsing="false" prefHeight="110.0" prefWidth="186.0" style="-fx-background-color: #ffffff;" GridPane.rowIndex="2">
                    <GridPane.margin>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                    </GridPane.margin>
                </Button>
                <Button mnemonicParsing="false" prefHeight="106.0" prefWidth="188.0" style="-fx-background-color: #ffffff;" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <GridPane.margin>
                        <Insets bottom="10.0" left="10.0" right="20.0" top="10.0" />
                    </GridPane.margin>
                </Button>
                <Button mnemonicParsing="false" prefHeight="110.0" prefWidth="192.0" style="-fx-background-color: #ffffff;" GridPane.columnIndex="2" GridPane.rowIndex="2">
                    <GridPane.margin>
                        <Insets bottom="10.0" left="10.0" right="20.0" top="10.0" />
                    </GridPane.margin>
                </Button>
            </children>
            <BorderPane.margin>
                <Insets top="10.0" />
            </BorderPane.margin>
        </GridPane>
    </center>

    <!-- ================= BOTTOM ================= -->
    <bottom>
        <FlowPane alignment="CENTER" hgap="15.0" prefHeight="102.0" prefWidth="600.0" vgap="10.0" BorderPane.alignment="CENTER">
            <children>
                <Button fx:id="restartGameButton"
                        alignment="CENTER"
                        mnemonicParsing="false"
                        prefHeight="38.0"
                        prefWidth="315.0"
                        style="-fx-background-color:#2b7cee;
               -fx-background-radius:5px;
               -fx-border-radius:5px;
               -fx-font-size:14px;
               -fx-font-weight:bold;"
                        text="Restart the game"
                        textAlignment="CENTER"
                        textFill="WHITE"/>
                <Button mnemonicParsing="false"
                        onAction="#onExitPressed"
                        prefHeight="37.0"
                        prefWidth="315.0"
                        style="-fx-background-color:#ffffff;
               -fx-border-color:black;
               -fx-border-radius:5px;
               -fx-border-width:0.7px;
               -fx-font-size:14px;
               -fx-font-weight:bold;"
                        text="Exit to main menu"/>
            </children>
        </FlowPane>
    </bottom>

</BorderPane>
