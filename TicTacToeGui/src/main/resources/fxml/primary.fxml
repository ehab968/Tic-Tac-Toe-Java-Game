<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane fx:id="gamePane" prefHeight="634.0" prefWidth="769.0" style="-fx-background-color:#eaf1fd;" stylesheets="@../styles/styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.tictactoegui.PrimaryController">

    <!-- ================= TOP ================= -->
    <top>
        <VBox alignment="CENTER" spacing="10" style="-fx-background-color:white;                      -fx-padding:18;                      -fx-background-radius:18;                      -fx-effect:dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);">

            <FlowPane alignment="CENTER" hgap="30">

                <VBox alignment="CENTER" spacing="4">
                    <Text fx:id="userNameText" style="-fx-font-weight:800;                                  -fx-font-size:18;" text="Player X" />

                    <Text fx:id="userScoreText" style="-fx-font-size:14;                                  -fx-fill:#475569;" text="Score: 0" />

                    <Text fx:id="userStatusText" style="-fx-background-color:#95caff;                                  -fx-fill:#008000;                                  -fx-padding:4 14;                                  -fx-background-radius:999;                                  -fx-font-size:12;                                  -fx-font-weight:bold;" text="Your Turn" />
                </VBox>

                <Text style="-fx-font-size:26;                              -fx-font-weight:bold;                              -fx-fill:#2b7cee;" text="VS" />

                <VBox alignment="CENTER" spacing="4">
                    <Text fx:id="opponentNameText" style="-fx-font-weight:800;                                  -fx-font-size:18;" text="Player O" />

                    <Text fx:id="opponentScoreText" style="-fx-font-size:14;                                  -fx-fill:#475569;" text="Score: 0" />

                    <Text fx:id="opponentStatusText" style="-fx-background-color:#e5e7eb;                                  -fx-fill:#ef4444;                                  -fx-padding:4 14;                                  -fx-background-radius:999;                                  -fx-font-size:12;                                  -fx-font-weight:bold;" text="Waiting" />
                </VBox>

            </FlowPane>
        </VBox>
    </top>


    <!-- ================= CENTER ================= -->
    <center>
        <GridPane fx:id="gridPane" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="500.0" prefWidth="550.0" style="-fx-background-color: #2b7cee;-fx-border-color: #eaeaea        -fx-border-width: 2px;        -fx-border-radius: 20px;        -fx-background-radius: 20px;" BorderPane.alignment="CENTER">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="0.0" prefWidth="0.0" style="-fx-background-color: #ffffff;">
                    <GridPane.margin>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                    </GridPane.margin>
                </Button>
                <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="0.0" prefWidth="0.0" style="-fx-background-color: #ffffff;" GridPane.columnIndex="1">
                    <GridPane.margin>
                        <Insets bottom="10.0" left="10.0" right="20.0" top="10.0" />
                    </GridPane.margin>
                </Button>
                <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="0.0" prefWidth="0.0" style="-fx-background-color: #ffffff;" GridPane.columnIndex="2">
                    <GridPane.margin>
                        <Insets bottom="10.0" left="10.0" right="20.0" top="10.0" />
                    </GridPane.margin>
                </Button>
                <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="0.0" prefWidth="0.0" style="-fx-background-color: #ffffff;" GridPane.rowIndex="1">
                    <GridPane.margin>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                    </GridPane.margin>
                </Button>
                <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="0.0" prefWidth="0.0" style="-fx-background-color: #ffffff;" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <GridPane.margin>
                        <Insets bottom="10.0" left="10.0" right="20.0" top="10.0" />
                    </GridPane.margin>
                </Button>
                <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="0.0" prefWidth="0.0" style="-fx-background-color: #ffffff;" GridPane.columnIndex="2" GridPane.rowIndex="1">
                    <GridPane.margin>
                        <Insets bottom="10.0" left="10.0" right="20.0" top="10.0" />
                    </GridPane.margin>
                </Button>
                <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="0.0" prefWidth="0.0" style="-fx-background-color: #ffffff;" GridPane.rowIndex="2">
                    <GridPane.margin>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                    </GridPane.margin>
                </Button>
                <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="0.0" prefWidth="0.0" style="-fx-background-color: #ffffff;" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <GridPane.margin>
                        <Insets bottom="10.0" left="10.0" right="20.0" top="10.0" />
                    </GridPane.margin>
                </Button>
                <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="0.0" prefWidth="0.0" style="-fx-background-color: #ffffff;" GridPane.columnIndex="2" GridPane.rowIndex="2">
                    <GridPane.margin>
                        <Insets bottom="10.0" left="10.0" right="20.0" top="10.0" />
                    </GridPane.margin>
                </Button>
            </children>
            <BorderPane.margin>
                <Insets top="10.0" />
            </BorderPane.margin>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
        </GridPane>
    </center>

    <!-- ================= BOTTOM ================= -->
    <bottom>
        <FlowPane alignment="CENTER" hgap="15.0" prefHeight="102.0" prefWidth="613.0" vgap="10.0" BorderPane.alignment="CENTER">
            <children>
                <JFXButton fx:id="restartGameButton" alignment="CENTER" mnemonicParsing="false" prefHeight="38.0" prefWidth="315.0" text="Restart the round" textAlignment="CENTER" textFill="WHITE" />
                <JFXButton mnemonicParsing="false" onAction="#onExitPressed" prefHeight="37.0" prefWidth="315.0" style="-fx-background-color:#ffffff;-fx-text-fill: black;" text="Exit to main menu" />
            </children>
        </FlowPane>
    </bottom>

</BorderPane>
