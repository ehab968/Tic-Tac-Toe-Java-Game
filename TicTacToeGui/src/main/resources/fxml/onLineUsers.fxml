<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- Main Card -->

<VBox alignment="TOP_CENTER" maxHeight="703.0" maxWidth="693.0" prefHeight="597.0" prefWidth="635.0" spacing="0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" stylesheets="@../styles/styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.tictactoegui.OnlineUsersController">
     
    <!-- Header Section -->
    <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 10; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
         
        <!-- Top Bar -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Button maxHeight="59.0" maxWidth="42.0" onAction="#backToOnlinePage" prefHeight="59.0" prefWidth="33.0" style="-fx-pref-height: 10; -fx-font-size: 16;" text="←" textAlignment="RIGHT" wrapText="true">
                <font>
                    <Font size="27.0" />
                </font>
            </Button>

            <Region HBox.hgrow="ALWAYS" />
            <JFXButton fx:id="leaderBoardButton" onAction="#navToLeaderBoard" prefHeight="38" style="             -fx-background-color: linear-gradient(                 from 0% 0% to 100% 100%,                 #fff7cc 0%,                 #f6d365 35%,                 #d4af37 65%,                 #b8962e 100%             );             -fx-text-fill: #000000;             -fx-font-size: 14px;             -fx-font-weight: bold;             -fx-background-radius: 22;             -fx-padding: 7 20;             -fx-cursor: hand;              /* 3D / Elevation effect */             -fx-effect:                 dropshadow(gaussian, rgba(0,0,0,0.25), 4, 0, 0, 1),                 dropshadow(gaussian, rgba(212,175,55,0.8), 12, 0, 0, 5);         " text="🏆 Leaderboard">
                <font>
                    <Font size="14.0" />
                </font>
            </JFXButton>

            <JFXButton fx:id="reloadButton" onAction="#onlineUserReload" style="-fx-pref-height: 10; -fx-font-size: 16;" text="⟳">
                <font>
                    <Font size="23.0" />
                </font>
            </JFXButton>
        </HBox>
         
        <!-- Page Title -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <VBox spacing="2">
                <Label fx:id="screenTitle" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Online Players" />
                <Label fx:id="descriptionText" style="-fx-font-size: 15px; -fx-text-fill: #6b7280;" text="Find an opponent to start a game">
                    <font>
                        <Font size="27.0" />
                    </font>
                </Label>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="onlineUsersText" style="-fx-background-color: #2b7cee33; -fx-text-fill: #2b7cee; -fx-padding: 3 8 3 8; -fx-background-radius: 20; -fx-font-weight: bold; -fx-font-size: 20px;" text="12 Online">
                <font>
                    <Font size="17.0" />
                </font>
            </Label>
        </HBox>
    </VBox>
     
    <!-- Scrollable User List -->
    <ScrollPane fitToWidth="true" prefHeight="520.0" prefWidth="400.0" style="-fx-background: transparent; -fx-background-color: transparent;" vbarPolicy="AS_NEEDED">
        <VBox fx:id="userListContainer" spacing="10" style="-fx-padding: 10;">
       
        </VBox>
     
    </ScrollPane>
</VBox>
