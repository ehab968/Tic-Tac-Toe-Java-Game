<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.media.MediaView?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="root" prefHeight="493.0" prefWidth="484.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-width: 2;  -fx-border-color: #d1d5db;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.tictactoegui.WinDialogController">
    <children>
        <VBox prefHeight="523.0" prefWidth="539.0">
            <children>
            <StackPane alignment="CENTER_RIGHT" prefHeight="33.0" prefWidth="539.0">
               <children>
                      <Region fx:id="topStrap" minHeight="20" prefHeight="29.0" prefWidth="543.0" style="-fx-background-color: #2b7cee; -fx-background-radius: 0 0 12 12;" />
                        <Label fx:id="topTitle" alignment="CENTER" contentDisplay="CENTER" maxWidth="1.7976931348623157E308" style="-fx-font-weight: 800;" text="Winner 🎉🎉" textAlignment="CENTER" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="30.0" />
                            </font>
                        </Label>
                  <JFXButton alignment="CENTER" buttonType="RAISED" mnemonicParsing="false" onAction="#onCloseButton" style="-fx-background-color: TRANSPARENT;" text="X" textFill="WHITE">
                     <font>
                        <Font name="Bell MT Bold" size="18.0" />
                     </font>
                     <StackPane.margin>
                        <Insets right="10.0" />
                     </StackPane.margin>
                  </JFXButton>
               </children>
            </StackPane>
                <VBox alignment="CENTER" spacing="0.0">
                    <padding>
                        <Insets bottom="24.0" left="32.0" right="32.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER" spacing="4.0">
                            <children>
                                <Label fx:id="descriptionTxt" style="-fx-font-weight: 500;" text="You won against" textFill="#2b7cee">
                           <font>
                              <Font name="System Bold" size="16.0" />
                           </font></Label>
                                <Label fx:id="opponentName" text="AlexGamer99">
                           <font>
                              <Font name="System Bold Italic" size="18.0" />
                           </font></Label>
                            </children>
                            <VBox.margin>
                                <Insets top="4.0" />
                            </VBox.margin>
                        </HBox>
                        <StackPane alignment="BOTTOM_CENTER" prefHeight="99.0" prefWidth="416.0">
                            <children>

                                <MediaView fx:id="mediaView" fitHeight="240" preserveRatio="true" smooth="true" />
                                <Label fx:id="videoText" alignment="CENTER" text="🎉 Bravo! You Win!" textAlignment="CENTER" StackPane.alignment="BOTTOM_CENTER">
                                    <padding>
                                        <Insets bottom="19.0" />
                                    </padding>
                                    <font>
                                        <Font name="Bauhaus 93" size="14.0" />
                                    </font>
                                </Label>
                            </children>
                        </StackPane>
                        <HBox alignment="CENTER" prefHeight="70.0" prefWidth="376.0" spacing="0.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 16; -fx-border-color: #f1f5f9; -fx-border-radius: 16;">
                            <children>
                                <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label style="-fx-text-fill: #94a3b8; -fx-font-weight: 800; -fx-font-size: 10px;" text="TOTAL SCORE" />
                                        <Label fx:id="scoreLabel" style="-fx-text-fill: #0f172a; -fx-font-weight: 700; -fx-font-size: 20px;" text="1,250" />
                                    </children>
                                    <padding>
                                        <Insets left="16.0" />
                                    </padding>
                                </VBox>
                                <Region maxWidth="1.0" minWidth="1.0" prefWidth="1.0" style="-fx-background-color: #e2e8f0;">
                                    <HBox.margin>
                                        <Insets bottom="12.0" top="12.0" />
                                    </HBox.margin>
                                </Region>
                                <VBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label style="-fx-text-fill: #94a3b8; -fx-font-weight: 800; -fx-font-size: 10px;" text="UPDATE" />
                                        <HBox alignment="CENTER_RIGHT" spacing="4.0">
                                            <children>
                                                <Label fx:id="updatedScoreLabel" style="-fx-text-fill: #10b981; -fx-font-weight: 700; -fx-font-size: 18px;" text="+20" />
                                            </children>
                                        </HBox>
                                    </children>
                                    <padding>
                                        <Insets right="16.0" />
                                    </padding>
                                </VBox>
                            </children>
                            <VBox.margin>
                                <Insets top="32.0" />
                            </VBox.margin>
                        </HBox>
                    </children>
                </VBox>
                <FlowPane alignment="CENTER" hgap="15.0" prefHeight="70.0" prefWidth="543.0">
                    <children>
                        <JFXButton alignment="CENTER" buttonType="RAISED" onAction="#onBackToMainMenu" prefHeight="36.0" prefWidth="168.0" style="-fx-background-color: white; -fx-border-color: #2b7cee; -fx-background-radius: 12; -fx-border-radius: 12; -fx-text-fill: #475569; -fx-font-weight: 800; -fx-font-size: 14px; -fx-cursor: hand;" text="Back to Menu">
                            <graphic>
                                <ImageView fitHeight="18.0" fitWidth="18.0" rotate="180.0">
                                    <image>
                                        <Image url="@../images/exit.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </JFXButton>
                        <JFXButton alignment="CENTER" buttonType="RAISED" onAction="#onPlayAgain" prefHeight="36.0" prefWidth="168.0" style="-fx-background-color: #2b7cee; -fx-border-color: #2b7cee; -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 12; -fx-border-radius: 12; -fx-font-size: 14px; -fx-cursor: hand;" text="Play Again" textAlignment="CENTER">
                            <graphic>
                                <ImageView fitHeight="18.0" fitWidth="18.0">
                                    <image>
                                        <Image url="@../images/refresh.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </JFXButton>
                    </children>
                </FlowPane>
            </children>
        </VBox>
    </children>
</StackPane>